{
    "annotations": {
      "list": []
    },
    "editable": true,
    "graphTooltip": 1,
    "panels": [
      {
        "title": "Redis Cache Hit Ratio",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "100 * sum(rate(kodekloud_redis_cache_hits_total[5m])) / (sum(rate(kodekloud_redis_cache_hits_total[5m])) + sum(rate(kodekloud_redis_cache_misses_total[5m])))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 70
                },
                {
                  "color": "green",
                  "value": 90
                }
              ]
            }
          }
        }
      },
      {
        "title": "Redis p95 Latency",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 0
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (le) (rate(kodekloud_redis_operation_duration_seconds_bucket[5m])))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "title": "Redis Errors / sec",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum(rate(kodekloud_redis_operations_total{status=\"error\"}[5m]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        }
      },
      {
        "title": "Cache Hits vs Misses",
        "type": "timeseries",
        "gridPos": {
          "h": 9,
          "w": 24,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "sum by (cache) (rate(kodekloud_redis_cache_hits_total[5m]))",
            "legendFormat": "HIT - {{cache}}",
            "refId": "A"
          },
          {
            "expr": "sum by (cache) (rate(kodekloud_redis_cache_misses_total[5m]))",
            "legendFormat": "MISS - {{cache}}",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        }
      },
      {
        "title": "Redis Operations / sec",
        "type": "timeseries",
        "gridPos": {
          "h": 9,
          "w": 12,
          "x": 0,
          "y": 17
        },
        "targets": [
          {
            "expr": "sum by (operation) (rate(kodekloud_redis_operations_total[5m]))",
            "legendFormat": "{{operation}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        }
      },
      {
        "title": "Redis p95 Latency by Operation",
        "type": "timeseries",
        "gridPos": {
          "h": 9,
          "w": 12,
          "x": 12,
          "y": 17
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(kodekloud_redis_operation_duration_seconds_bucket[5m])))",
            "legendFormat": "{{operation}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "title": "Cart Operations / sec",
        "type": "timeseries",
        "gridPos": {
          "h": 9,
          "w": 24,
          "x": 0,
          "y": 26
        },
        "targets": [
          {
            "expr": "sum by (operation) (rate(kodekloud_redis_operations_total{operation=~\"cart_.*\"}[5m]))",
            "legendFormat": "{{operation}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        }
      }
    ],
    "schemaVersion": 39,
    "tags": [
      "redis",
      "cache",
      "application"
    ],
    "templating": {
      "list": []
    },
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "title": "Redis - Application Performance",
    "uid": "redis-app-performance"
  }
  